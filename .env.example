# Copy to .env and fill in. Never commit .env.

# Required for AI chat (OpenRouter key).
OPENROUTER_API_KEY=

# Optional: real market data from Massive (Polygon.io). Leave blank to use the built-in simulator.
MASSIVE_API_KEY=

# true = deterministic scripted AI replies (free, no API key needed; used by tests and the eval --mock run).
LLM_MOCK=false

# Optional overrides. Leave commented out to use the defaults shown.

# Risk limits (percentages are of total portfolio value).
# RISK_MIN_QUANTITY=0.0001
# RISK_MAX_ORDER_PCT=100
# RISK_MAX_POSITION_PCT=50
# RISK_WARN_POSITION_PCT=25
# RISK_MIN_CASH_PCT_WARN=5

# Per-address usage limits (requests per hour).
# RATE_LIMIT_CHAT_PER_HOUR=15
# RATE_LIMIT_TRADES_PER_HOUR=20

# Maximum number of watchlist tickers.
# MAX_WATCHLIST=50
